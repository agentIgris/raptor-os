{
  "name": "@raptor/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money/index.ts",
    "./prize": "./src/prize/index.ts",
    "./attendance": "./src/attendance/index.ts",
    "./authorization": "./src/authorization/index.ts",
    "./audit": "./src/audit/index.ts",
    "./content": "./src/content/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./documents": "./src/documents/index.ts",
    "./employment": "./src/employment/index.ts",
    "./expense": "./src/expense/index.ts",
    "./inventory": "./src/inventory/index.ts",
    "./invoicing": "./src/invoicing/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./minors": "./src/minors/index.ts",
    "./obligations": "./src/obligations/index.ts",
    "./partners": "./src/partners/index.ts",
    "./reconciliation": "./src/reconciliation/index.ts",
    "./tiers": "./src/tiers/index.ts",
    "./tryout": "./src/tryout/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --build --noEmit false --emitDeclarationOnly",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "echo \"no integration tests in core\"",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}