# ==========================================================
# Raptor OS — local development environment
#
# Copy to .env.local and fill in. NO real credentials are
# inherited from any previous system: every value here is
# local-only. Nothing in this file is a production secret.
# ==========================================================

# --- Database (local Postgres via PGlite or a local server) ---
DATABASE_URL=postgresql://raptor_app@127.0.0.1:5432/raptor_os
# Owner role used only for migrations. Never used by the app.
DATABASE_MIGRATION_URL=postgresql://postgres@127.0.0.1:5432/raptor_os
# Optional directory for PGlite when running without a server.
PGLITE_DATA_DIR=.data/pglite

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-not-a-real-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Email (local sink) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Object storage (local disk) ---
STORAGE_ROOT=.data/storage
STORAGE_SIGNING_SECRET=dev-only-signing-secret-change-me