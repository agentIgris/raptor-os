# ==========================================================
# Raptor OS — local development environment
#
# Copy to .env.local and fill in. NO real credentials are
# inherited from any previous system: every value here is
# local-only. Nothing in this file is a production secret.
# ==========================================================

# --- Database (local Postgres via PGlite or a local server) ---
DATABASE_URL=postgresql://raptor_app@127.0.0.1:5432/raptor_os
# Owner role used only for migrations. Never used by the app.
DATABASE_MIGRATION_URL=postgresql://postgres@127.0.0.1:5432/raptor_os
# Optional directory for PGlite when running without a server.
PGLITE_DATA_DIR=.data/pglite

# --- Auth ---
# BETTER_AUTH_SECRET signs session cookies, email-verification tokens and
# password-reset tokens. Anyone who can guess it can mint a session for ANY
# account, including one whose email address was never verified.
#
# It is therefore deliberately left EMPTY here. This file used to ship
# `dev-only-not-a-real-secret-change-me`, which taught every operator who copied
# it that the value is disposable; `packages/auth/src/env.ts` now rejects that
# string (and every other placeholder) by name.
#
# Generate your own, once per environment, and never commit it:
#     openssl rand -base64 32
#
# Minimum 32 characters, at least 12 distinct characters, not a placeholder.
# The same rule applies in development - a development secret is the secret that
# gets promoted, and the NODE_ENV that permitted a weak one does not travel with
# it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth ("Sign in with Google") ---
# Both set or neither. `packages/auth/src/env.ts` refuses a half-configured
# pair, and the web sign-in page renders no Google button unless both are
# present — a button that starts an OAuth flow with no credential behind it
# strands the user on Google's error page.
#
# From the Google Cloud Console (APIs & Services → Credentials → OAuth client
# ID, application type "Web application"):
#   Authorized redirect URI: http://localhost:4000/api/auth/callback/google
# (replace the origin per environment; the path is fixed by Better Auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Names the request header carrying the client IP for rate limiting. Leave EMPTY
# unless a reverse proxy in front of this app OVERWRITES that header.
#
# With it empty, `packages/auth` reads no forwarding header at all, so a client
# cannot choose its own rate-limit bucket by sending `X-Forwarded-For`. The cost
# is that every client shares one bucket per path in production. Set this to the
# header your edge overwrites (for example `cf-connecting-ip`) to get per-IP
# budgets back without reopening the spoofing hole.
AUTH_TRUSTED_IP_HEADERS=
# CIDR ranges of those proxies. Set this whenever AUTH_TRUSTED_IP_HEADERS is
# set: without it Better Auth trusts any single-value forwarding header, which
# is the client-supplied case this setting exists to prevent.
AUTH_TRUSTED_PROXIES=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public-site tenant slug (see .env.local notes). Empty = all empty states.
PUBLIC_ORG_SLUG=
# Public-site tenant id (uuid). Skips the RLS-gated slug lookup.
PUBLIC_ORG_ID=
NODE_ENV=development
LOG_LEVEL=debug

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Email (Resend API; empty = mail sends fail loudly, nothing swallows) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Email (local sink) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Object storage (local disk) ---
STORAGE_ROOT=.data/storage
STORAGE_SIGNING_SECRET=dev-only-signing-secret-change-me

# --- CMS (Payload) ---
# Generate per environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_SECRET=
# Postgres credential for Payload migrate + admin runtime.
PAYLOAD_DATABASE_URI=

# --- Object storage (Supabase S3-compatible) ---
# Access key + secret from the Supabase dashboard (S3 access keys).
# Never commit values; this file keeps names only.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=