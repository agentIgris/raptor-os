# ==========================================================
# Raptor OS — local development environment
#
# Copy to .env.local and fill in. The defaults below match
# scripts/local-bootstrap.sql + scripts/preview-seed.sql on a
# native Postgres 16 at 127.0.0.1:5432: run those two files as
# postgres first, and everything except the three secrets
# (BETTER_AUTH_SECRET, GOOGLE_*, PAYLOAD_SECRET) works as-is.
# The local passwords (`raptor_local_dev_only`) are committed
# in the bootstrap script — they only ever unlock a database
# bound to loopback.
# ==========================================================

# --- Database (local Postgres from local-bootstrap.sql) ---
# App runtime: least-privilege role, RLS enforced.
DATABASE_URL=postgresql://raptor_app:raptor_local_dev_only@127.0.0.1:5432/raptor_os
# Migration runner: owns schema, refused by the app itself
# (packages/auth/src/env.ts rejects it in DATABASE_URL).
DATABASE_MIGRATION_URL=postgresql://raptor_migrator:raptor_local_dev_only@127.0.0.1:5432/raptor_os
# Optional directory for PGlite when running without a server.
PGLITE_DATA_DIR=.data/pglite

# --- Auth ---
# BETTER_AUTH_SECRET signs session cookies, email-verification tokens and
# password-reset tokens. Anyone who can guess it can mint a session for ANY
# account, including one whose email address was never verified.
#
# It is therefore deliberately left EMPTY here. This file used to ship
# `dev-only-not-a-real-secret-change-me`, which taught every operator who copied
# it that the value is disposable; `packages/auth/src/env.ts` now rejects that
# string (and every other placeholder) by name.
#
# Generate your own, once per environment, and never commit it:
#     openssl rand -base64 32
#
# Minimum 32 characters, at least 12 distinct characters, not a placeholder.
# The same rule applies in development - a development secret is the secret that
# gets promoted, and the NODE_ENV that permitted a weak one does not travel with
# it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth ("Sign in with Google") ---
# Both set or neither. `packages/auth/src/env.ts` refuses a half-configured
# pair, and the web sign-in page renders no Google button unless both are
# present — a button that starts an OAuth flow with no credential behind it
# strands the user on Google's error page.
#
# From the Google Cloud Console (APIs & Services → Credentials → OAuth client
# ID, application type "Web application"):
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (replace the origin per environment; the path is fixed by Better Auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Names the request header carrying the client IP for rate limiting. Leave EMPTY
# unless a reverse proxy in front of this app OVERWRITES that header.
#
# With it empty, `packages/auth` reads no forwarding header at all, so a client
# cannot choose its own rate-limit bucket by sending `X-Forwarded-For`. The cost
# is that every client shares one bucket per path in production. Set this to the
# header your edge overwrites (for example `cf-connecting-ip`) to get per-IP
# budgets back without reopening the spoofing hole.
AUTH_TRUSTED_IP_HEADERS=
# CIDR ranges of those proxies. Set this whenever AUTH_TRUSTED_IP_HEADERS is
# set: without it Better Auth trusts any single-value forwarding header, which
# is the client-supplied case this setting exists to prevent.
AUTH_TRUSTED_PROXIES=

# How many sign-in attempts one client ADDRESS may make per minute.
#
# The budget is per ADDRESS, and a local machine or a demo has exactly one:
# signing in as owner, then admin, then coach to show a colleague is three
# sign-ins in a row from 127.0.0.1, and the fourth was refused with a 429
# that read as "sign-in does not work".
#
# Leave it EMPTY and the environment decides: 5 per minute in production
# (below any human's typing rate, far below what a credential-stuffing run
# needs) and 30 outside production. Set it when a deployment shares one
# address across an office.
#
# The control that actually bounds password GUESSING is not this one: it is
# the per-ACCOUNT lockout (5 failures, then 15 minutes), which this does not
# change.
AUTH_RATE_LIMIT_SIGNIN_MAX=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public-site tenant, provisioned by scripts/preview-seed.sql.
PUBLIC_ORG_SLUG=raptor
# Skips the RLS-gated slug lookup; keep in sync with the seed's org row.
PUBLIC_ORG_ID=0c295a27-1295-4dcf-9a0e-2f77a772f14d
NODE_ENV=development
LOG_LEVEL=debug

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Email (Resend API) ---
# Empty key + NODE_ENV=development = the development fallback in
# packages/auth/src/email.ts prints verification/reset links to the server
# console instead of sending. In any other NODE_ENV a missing key fails
# loudly — links are bearer credentials and are never printed elsewhere.
RESEND_API_KEY=
EMAIL_FROM=

# --- Email (local sink) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Object storage (local disk) ---
STORAGE_ROOT=.data/storage
STORAGE_SIGNING_SECRET=dev-only-signing-secret-change-me

# --- CMS (Payload) ---
# Generate per environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_SECRET=
# cms_app role (provision.sql grants it CONNECT + schema usage, then
# `payload migrate` owns the cms_* tables).
PAYLOAD_DATABASE_URI=postgresql://cms_app:raptor_local_dev_only@127.0.0.1:5432/raptor_os

# --- Object storage (S3-compatible; OPTIONAL) ---
# Set ALL THREE credentials to switch CMS media uploads to a bucket
# (staging/Vercel). Leave every S3_* value empty locally: with none set,
# payload.config.ts omits the storage plugin and files land on local disk
# (packages/cms/.media, gitignored), served through the CMS file route.
# Never commit values; this file keeps names only.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
