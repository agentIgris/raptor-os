{
    "name":  "raptor-os",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Multi-tenant Esports Organisation OS",
    "engines":  {
                    "node":  "\u003e=22.0.0"
                },
    "packageManager":  "pnpm@12.10.1",
    "scripts":  {
                    "bootstrap":  "node scripts/bootstrap-local.mjs",
                    "docs:check":  "node scripts/check-doc-links.mjs",
                    "build":  "turbo run build",
                    "dev":  "turbo run dev",
                    "dev:local":  "node scripts/dev-env.mjs",
                    "lint":  "turbo run lint",
                    "lint:fix":  "turbo run lint -- --fix",
                    "typecheck":  "turbo run typecheck",
                    "test":  "turbo run test",
                    "test:unit":  "turbo run test:unit",
                    "test:integration":  "turbo run test:integration",
                    "test:e2e":  "turbo run test:e2e",
                    "test:a11y":  "turbo run test:a11y",
                    "db:generate":  "turbo run db:generate",
                    "db:migrate":  "turbo run db:migrate",
                    "db:rollback":  "turbo run db:rollback",
                    "db:seed":  "turbo run db:seed",
                    "db:studio":  "turbo run db:studio",
                    "verify":  "pnpm lint \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test",
                    "ci":  "turbo run ci",
                    "db:sync-supabase":  "cd packages/db \u0026\u0026 pnpm exec tsx ../../scripts/sync-supabase-baseline.ts",
                    "supabase":  "supabase"
                },
    "devDependencies":  {
                            "@eslint/js":  "10.0.1",
                            "@types/node":  "24.10.1",
                            "eslint":  "10.12.0",
                            "globals":  "17.13.0",
                            "prettier":  "3.9.9",
                            "turbo":  "2.11.7",
                            "typescript":  "6.0.3",
                            "typescript-eslint":  "8.71.1",
                            "vitest":  "5.0.3",
                            "supabase":  "2.120.0"
                        }
}
